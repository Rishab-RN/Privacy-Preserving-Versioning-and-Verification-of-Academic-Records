# Run npm run setup to generate local passwords in .env. Never commit .env.
NODE_ENV=development
API_HOST=127.0.0.1
API_PORT=4000

# Optional development containers. These are example-only credentials.
POSTGRES_DB=scholarproof
POSTGRES_USER=scholarproof
POSTGRES_PASSWORD=replace-with-a-local-postgres-password
POSTGRES_PORT=55432
MONGO_ROOT_USER=scholarproof
MONGO_ROOT_PASSWORD=replace-with-a-local-mongo-password
MONGO_PORT=57017

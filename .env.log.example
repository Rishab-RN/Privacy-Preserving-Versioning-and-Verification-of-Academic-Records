# Generated by npm run log:setup. Existing values and signing keys are preserved.
LOG_POSTGRES_USER=academic_log_local
LOG_POSTGRES_PASSWORD=replace-with-generated-log-password
LOG_MONGO_USER=academic_log_local
LOG_MONGO_PASSWORD=replace-with-generated-log-mongo-password
LOG_MONGO_DB=scholarproof_evidence
# Keys and accepted observations are private local files outside SQL/MongoDB.
# This same-host observer demonstrates the protocol, not independent control.

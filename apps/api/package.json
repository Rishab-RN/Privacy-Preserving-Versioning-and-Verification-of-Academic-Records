{
  "name": "@scholarproof/api",
  "version": "0.1.0",
  "private": true,
  "type": "module",
  "scripts": {
    "dev": "tsx watch --env-file-if-exists=../../.env --env-file-if-exists=../../.env.api --env-file-if-exists=../../.env.zk --env-file-if-exists=../../.env.graph src/server.ts",
    "start": "node --env-file-if-exists=../../.env --env-file-if-exists=../../.env.api --env-file-if-exists=../../.env.zk --env-file-if-exists=../../.env.graph dist/server.js",
    "test": "tsx --test test/*.test.ts",
    "check:services": "tsx --env-file-if-exists=../../.env scripts/check-services.ts",
    "db:migrate": "tsx --env-file-if-exists=../../.env scripts/db/migrate.ts up",
    "db:status": "tsx --env-file-if-exists=../../.env scripts/db/migrate.ts status",
    "db:seed": "tsx --env-file-if-exists=../../.env scripts/db/seed.ts",
    "db:demo": "tsx --env-file-if-exists=../../.env scripts/db/demo.ts",
    "db:plan": "tsx --env-file-if-exists=../../.env scripts/db/demo.ts --plan",
    "test:db": "tsx --env-file-if-exists=../../.env scripts/db/test.ts",
    "access:setup": "tsx --env-file-if-exists=../../.env scripts/access/setup.ts",
    "access:demo": "tsx --env-file-if-exists=../../.env scripts/access/demo.ts",
    "access:smoke": "tsx scripts/access/smoke.ts",
    "test:integration": "tsx --env-file-if-exists=../../.env --env-file-if-exists=../../.env.graph scripts/access/test.ts",
    "workflow:demo": "tsx --env-file-if-exists=../../.env scripts/workflow/demo.ts",
    "workflow:smoke": "tsx --env-file-if-exists=../../.env --env-file-if-exists=../../.env.worker scripts/workflow/smoke.ts"
  },
  "dependencies": {
    "@academic-records/verification": "0.1.0",
    "@academic-records/zk": "0.1.0",
    "@scholarproof/contracts": "0.1.0",
    "express": "5.3.0",
    "jose": "6.2.18",
    "mongodb": "7.9.1",
    "neo4j-driver": "6.3.2",
    "pg": "8.23.1",
    "zod": "4.6.7"
  }
}

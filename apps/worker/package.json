{
  "name": "@scholarproof/worker",
  "version": "0.1.0",
  "private": true,
  "type": "module",
  "scripts": {
    "dev": "tsx --env-file-if-exists=../../.env --env-file-if-exists=../../.env.worker src/main.ts",
    "once": "tsx --env-file-if-exists=../../.env --env-file-if-exists=../../.env.worker src/main.ts --once",
    "replay": "tsx --env-file-if-exists=../../.env --env-file-if-exists=../../.env.worker src/main.ts --replay",
    "setup": "tsx --env-file-if-exists=../../.env scripts/setup.ts",
    "test": "tsx --test test/*.test.ts"
  },
  "dependencies": {
    "mongodb": "7.9.1",
    "pg": "8.23.1",
    "zod": "4.6.7"
  }
}

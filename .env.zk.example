# Generated locally by npm run zk:setup after artifact and issuer-key preparation.
# Requires migration 0012 and a configured restricted data API.
ZK_ENABLED=true
# Optional independently provisioned Ed25519 log verification key (PEM).
# Defaults to the local operator's public key at .runtime/log-keys/public.pem.
# ZK_LOG_PUBLIC_KEY_FILE=C:/path/to/trusted-log-public.pem
